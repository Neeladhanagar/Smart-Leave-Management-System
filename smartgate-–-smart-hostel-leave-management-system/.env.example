# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SmartGate Backend Configuration
PORT=3000
# Development only: blank uses local MongoDB. Production requires a private managed MongoDB URI.
MONGODB_URI=""
# Frontend build-time variable. For separate production deployments, set the deployed backend origin (no /api).
# Blank is only appropriate when Express serves both the frontend and API from the same origin.
VITE_API_BASE_URL=""
# Backend runtime variable. Comma-separated exact frontend origins (scheme + host + optional port; no paths).
# Blank allows same-origin use only; cross-origin browser requests will be rejected.
CORS_ORIGINS=""
# Backend production variables; never expose these through VITE_*.
# MONGODB_URI, JWT_SECRET and QR_SIGNING_SECRET must be set in production.
JWT_SECRET="replace_with_secure_random_jwt_secret"
QR_SIGNING_SECRET="replace_with_secure_random_qr_secret"
# One-time first-admin CLI bootstrap; set only in the backend environment.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Required only when intentionally seeding an empty database with bundled sample accounts.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
DEMO_SEED_PASSWORD=""
COLLEGE_NAME="National Institute of Engineering & Technology"

